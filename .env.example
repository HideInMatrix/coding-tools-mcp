AGENT_RUNTIME_OAUTH_PASSWORD="自定义登录密码"
AGENT_RUNTIME_NETWORK_PROVIDER="cloudflare"
AGENT_RUNTIME_SERVER_URL="https://company.mcp.example.com"
AGENT_RUNTIME_TUNNEL_TOKEN="当前电脑独立 Named Tunnel 安装命令中 --token 后面的值"

# 多电脑固定入口：每台电脑使用不同 hostname、独立 Named Tunnel 和独立 Tunnel Token：
# 公司电脑: AGENT_RUNTIME_SERVER_URL="https://company.mcp.example.com"
# 家里电脑: AGENT_RUNTIME_SERVER_URL="https://home.mcp.example.com"
# ChatGPT 中对应填写 https://company.mcp.example.com/mcp 或 https://home.mcp.example.com/mcp
# URL Path 能力保留给后续 Local MCP Gateway，同一 hostname 的多 Profile 分发当前尚未启用。

# OAuth Client 使用动态注册 / Client ID Metadata Document，不提供手工 Client ID / Secret 配置。

# FRP（当 AGENT_RUNTIME_NETWORK_PROVIDER=frp 时）
# AGENT_RUNTIME_FRPC="/path/to/frpc"
# AGENT_RUNTIME_FRP_CONFIG="/path/to/frpc.toml"

# ngrok（当 AGENT_RUNTIME_NETWORK_PROVIDER=ngrok 时）
# AGENT_RUNTIME_NGROK="/path/to/ngrok"
# AGENT_RUNTIME_NGROK_AUTHTOKEN=""

# Tailscale Funnel（当 AGENT_RUNTIME_NETWORK_PROVIDER=tailscale 时）
# AGENT_RUNTIME_TAILSCALE="/path/to/tailscale"