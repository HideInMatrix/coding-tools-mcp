CODING_TOOLS_MCP_OAUTH_PASSWORD="自定义登录密码"
CODING_TOOLS_MCP_NETWORK_PROVIDER="cloudflare"
CODING_TOOLS_MCP_SERVER_URL="https://mcp.example.com"
CODING_TOOLS_MCP_TUNNEL_TOKEN="Cloudflare Named Tunnel 安装命令中 --token 后面的值"

# 高级 OAuth（可选）
# 默认使用 RFC 7591 Dynamic Client Registration，不需要填写 Client ID / Secret。
# 只有目标 MCP Client 不支持 DCR、需要手动预注册时再启用：
# CODING_TOOLS_MCP_OAUTH_CLIENT_ID="coding-tools-desktop"
# CODING_TOOLS_MCP_OAUTH_CLIENT_SECRET="自定义随机 OAuth Client Secret"

# FRP（当 CODING_TOOLS_MCP_NETWORK_PROVIDER=frp 时）
# CODING_TOOLS_MCP_FRPC="/path/to/frpc"
# CODING_TOOLS_MCP_FRP_CONFIG="/path/to/frpc.toml"

# ngrok（当 CODING_TOOLS_MCP_NETWORK_PROVIDER=ngrok 时）
# CODING_TOOLS_MCP_NGROK="/path/to/ngrok"
# CODING_TOOLS_MCP_NGROK_AUTHTOKEN=""

# Tailscale Funnel（当 CODING_TOOLS_MCP_NETWORK_PROVIDER=tailscale 时）
# CODING_TOOLS_MCP_TAILSCALE="/path/to/tailscale"