CODING_TOOLS_MCP_OAUTH_PASSWORD="自定义登录密码"
CODING_TOOLS_MCP_NETWORK_PROVIDER="cloudflare"
CODING_TOOLS_MCP_SERVER_URL="https://mcp.example.com/company"
CODING_TOOLS_MCP_TUNNEL_TOKEN="当前电脑独立 Named Tunnel 安装命令中 --token 后面的值"

# 多电脑共用同一公网域名时，为每台电脑使用不同实例 Path 和不同 Tunnel Token：
# 公司电脑: CODING_TOOLS_MCP_SERVER_URL="https://mcp.example.com/company"
# 家里电脑: CODING_TOOLS_MCP_SERVER_URL="https://mcp.example.com/home"
# ChatGPT 中对应填写 https://mcp.example.com/company/mcp 或 https://mcp.example.com/home/mcp
# Cloudflare Path Router 配置见 docs/multi-mcp-server-manager/11-CLOUDFLARE-PATH-ROUTING.md

# OAuth Client 使用动态注册 / Client ID Metadata Document，不提供手工 Client ID / Secret 配置。

# FRP（当 CODING_TOOLS_MCP_NETWORK_PROVIDER=frp 时）
# CODING_TOOLS_MCP_FRPC="/path/to/frpc"
# CODING_TOOLS_MCP_FRP_CONFIG="/path/to/frpc.toml"

# ngrok（当 CODING_TOOLS_MCP_NETWORK_PROVIDER=ngrok 时）
# CODING_TOOLS_MCP_NGROK="/path/to/ngrok"
# CODING_TOOLS_MCP_NGROK_AUTHTOKEN=""

# Tailscale Funnel（当 CODING_TOOLS_MCP_NETWORK_PROVIDER=tailscale 时）
# CODING_TOOLS_MCP_TAILSCALE="/path/to/tailscale"