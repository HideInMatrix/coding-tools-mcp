name = "coding-tools-mcp-path-router"
main = "path-router.js"
compatibility_date = "2026-08-19"

# 替换为实际统一公网 hostname 和 Cloudflare zone。
[[routes]]
pattern = "mcp.example.com/*"
zone_name = "example.com"

# 每个实例映射到对应独立 Named Tunnel 的 Published Application hostname。
# 不要把 Tunnel Token 放入 Worker 变量。
[vars]
MCP_ROUTE_MAP = '{"company":"https://company-origin.example.com","home":"https://home-origin.example.com"}'
